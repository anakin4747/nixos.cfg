
prompt off 2> /dev/null

autoload -Uz vcs_info
precmd() {
    printf "\033]133;A\007"
    vcs_info
}
zstyle ':vcs_info:git:*' formats '%b '

chpwd() {
    [[ -S "$NVIM" ]] || return
    # nohup is used to avoid the job number being displayed from the &
    nohup nvim --server "$NVIM" --remote-expr "chdir('$PWD')" > /dev/null 2>&1
}

zstyle ':completion:*' file-sort modification

setopt PROMPT_SUBST

ERR_CODE='%B%F{red}%(?..%? )%f%b'
GIT_FMT='%F{green}${vcs_info_msg_0_}%f'
PROMPT_ICON_FMT='%B%F{blue}$ %f%b'
PROMPT="$ERR_CODE$GIT_FMT%T $PROMPT_ICON_FMT"
[[ -n "$IN_NIX_SHELL" ]] && PROMPT="(nix) $PROMPT"

bindkey "^R" history-incremental-search-backward

export GPG_TTY=$(tty)
